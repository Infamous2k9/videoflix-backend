# ------------------------------------------------------------------
# Developer Akademie 
# ------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=adminpassword
DJANGO_SUPERUSER_EMAIL=admin@example.com

SECRET_KEY='replace-with-a-generated-secret-key'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

DB_NAME=videoflix_db
DB_USER=videoflix_user
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_user_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@videoflix.local

# ------------------------------------------------------------------
# Additional variables (from the starter / needed for Videoflix)
# ------------------------------------------------------------------
# Console backend prints emails to the docker logs (development).
# For real emails: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Frontend runs via Live Server on 127.0.0.1:5500 (not localhost!)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500
FRONTEND_BASE_URL=http://127.0.0.1:5500

# Links in the emails point to these frontend pages
AUTH_EMAIL_ACTIVATION=True
AUTH_ACTIVATION_PATH=/pages/auth/activate.html?uid={uid}&token={token}
PASSWORD_RESET_PATH=/pages/auth/confirm_password.html?uid={uid}&token={token}
# Validity of activation and reset links in seconds (3 days)
PASSWORD_RESET_TIMEOUT=259200

# JWT
JWT_SIGNING_KEY='replace-with-a-second-generated-key'
# False locally: Secure cookies are only sent over HTTPS
AUTH_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False
